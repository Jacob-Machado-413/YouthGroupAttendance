@page "/students"
@inject ApiService Api
@inject NavigationManager Nav

<h2>Students</h2>

<div>
    <input @bind="_search" @bind:event="oninput" placeholder="Search by name..." />
    <button @onclick="@Search">Search</button>
    <button @onclick="@LoadAll">Show All</button>
</div>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <table>
        <thead>
            <tr>
                @foreach (var col in Columns)
                {
                    <th aria-sort="@AriaSort(col.Key)">
                        <button class="sort-btn" @onclick="@(() => SortBy(col.Key))">
                            @col.Label<span class="sort-arrow">@Arrow(col.Key)</span>
                        </button>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Sorted())
            {
                <tr @onclick="@(() => Nav.NavigateTo($"/students/{s.Id}"))" style="cursor:pointer;">
                    <td>@s.FullName</td>
                    <td>@GradeHelper.GraduationYearToGrade(s.GraduationYear)</td>
                    <td>@s.Gender</td>
                    <td>@s.School</td>
                    <td>@s.TotalAttendances</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_error))
{
    <p class="error">@_error</p>
}

<style>
    .sort-btn { all: unset; cursor: pointer; font-weight: 600; white-space: nowrap; }
    .sort-btn:focus-visible { outline: 2px solid var(--pico-primary); outline-offset: 2px; border-radius: 2px; }
    .sort-arrow { display: inline-block; width: 1em; margin-left: 0.2em; color: var(--pico-muted-color); }
</style>

@code {
    private List<StudentResponse> _students = new();
    private string _search = string.Empty;
    private bool _loading;
    private string? _error;
    private string _sortKey = "name";
    private bool _sortAsc = true;

    private static readonly (string Key, string Label)[] Columns =
    {
        ("name", "Name"), ("grade", "Grade"), ("gender", "Gender"), ("school", "School"), ("attendances", "Attendances")
    };

    protected override async Task OnInitializedAsync() => await LoadAll();

    private void SortBy(string key)
    {
        if (_sortKey == key)
            _sortAsc = !_sortAsc;
        else
        {
            _sortKey = key;
            _sortAsc = key != "attendances"; // most attendances first on the first click
        }
    }

    private IEnumerable<StudentResponse> Sorted()
    {
        IOrderedEnumerable<StudentResponse> ordered = _sortKey switch
        {
            // A later graduation year is a lower grade, so "ascending grade" is descending year.
            "grade" => _sortAsc ? _students.OrderByDescending(s => s.GraduationYear) : _students.OrderBy(s => s.GraduationYear),
            "gender" => OrderText(s => s.Gender),
            "school" => OrderText(s => s.School),
            "attendances" => _sortAsc ? _students.OrderBy(s => s.TotalAttendances) : _students.OrderByDescending(s => s.TotalAttendances),
            _ => _sortAsc
                ? _students.OrderBy(s => s.FullName, StringComparer.OrdinalIgnoreCase)
                : _students.OrderByDescending(s => s.FullName, StringComparer.OrdinalIgnoreCase)
        };
        return _sortKey == "name" ? ordered : ordered.ThenBy(s => s.FullName, StringComparer.OrdinalIgnoreCase);
    }

    // Blank values always sort last, whichever direction is chosen.
    private IOrderedEnumerable<StudentResponse> OrderText(Func<StudentResponse, string?> key)
    {
        var blanksLast = _students.OrderBy(s => string.IsNullOrWhiteSpace(key(s)));
        return _sortAsc
            ? blanksLast.ThenBy(s => key(s)?.Trim(), StringComparer.OrdinalIgnoreCase)
            : blanksLast.ThenByDescending(s => key(s)?.Trim(), StringComparer.OrdinalIgnoreCase);
    }

    private string Arrow(string key) => key != _sortKey ? "" : _sortAsc ? "▲" : "▼";

    private string AriaSort(string key) => key != _sortKey ? "none" : _sortAsc ? "ascending" : "descending";

    private async Task LoadAll()
    {
        _loading = true;
        _error = null;
        try { _students = await Api.GetAllStudentsAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            await LoadAll();
            return;
        }
        _loading = true;
        _error = null;
        try { _students = await Api.SearchStudentsAsync(_search); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
